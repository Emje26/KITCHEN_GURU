<div class="container mx-auto px-4 py-8 max-w-2xl">
  <h1 class="text-3xl font-bold text-indigo-700 mb-6 border-b-4 border-indigo-200 pb-2">Mon Profil Nutritionnel</h1>

  <% if @profile.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
      <strong>Erreur(s):</strong>
      <ul class="list-disc list-inside">
        <% @profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: @profile, url: profile_path, method: :patch, class: "space-y-6") do |f| %>

    <div class="bg-white p-6 rounded-xl shadow-lg">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Informations personnelles</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :gender, "Genre", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :gender, options_for_select([["Homme", "homme"], ["Femme", "femme"], ["Autre", "autre"]], @profile.gender), {}, class: "w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <div>
          <%= f.label :age, "Âge", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :age, min: 18, max: 120, class: "w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>

      <div class="mt-4">
        <%= f.label :activity_level, "Niveau d'activité physique", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :activity_level, options_for_select([["Sédentaire", "sédentaire"], ["Modéré", "modéré"], ["Actif", "actif"]], @profile.activity_level), {}, class: "w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-lg">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Préférences de cuisine</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :weekly_budget_max, "Budget hebdomadaire max (€)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :weekly_budget_max, min: 10, step: 5, class: "w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <div>
          <%= f.label :max_prep_time_minutes, "Temps de préparation max (min)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :max_prep_time_minutes, min: 5, step: 5, class: "w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>

      <div class="mt-4">
        <%= f.label :allergies, "Allergies / Intolérances", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :allergies, placeholder: "Ex: Gluten, Lactose, Arachides", class: "w-full p-3 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500" %>
        <p class="text-xs text-gray-500 mt-1">Séparez les allergies par des virgules</p>
      </div>
    </div>

    <div class="flex justify-end space-x-4">
      <%= link_to "Annuler", planner_path, class: "px-6 py-3 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition" %>
      <%= f.submit "Enregistrer", class: "px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition cursor-pointer" %>
    </div>

  <% end %>
</div>
